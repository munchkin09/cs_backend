{
  "name": "cs_ai_analyzer",
  "version": "0.0.1",
  "description": "Just a great idea being created",
  "type": "module",
  "main": "src/index.js",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "start": "node backend/index.js",
    "dev": "npx tsx --env-file=.env src/index.ts",
    "build": "tsc --project tsconfig.json",
    "test": "jest . --runInBand",
    "test:watch": "jest . --watch",
    "test:coverage": "jest . --coverage",
    "test:coverage:watch": "jest . --coverage --watch",
    "docker:build": "docker build -t cs-backend .",
    "docker:run": "docker run -p 3000:3000 --env-file .env cs-backend",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose -f docker-compose.yml up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f cs-backend",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "author": "Ariadne & Munchkin",
  "license": "SEE LICENSE IN LICENSE.MD",
  "dependencies": {
    "@google-cloud/storage": "7.16.0",
    "@google/genai": "1.4.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "express": "5.1.0",
    "express-session": "1.18.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "8.1.0",
    "mongoose": "8.15.1",
    "multer": "^2.0.1",
    "passport": "0.7.0",
    "passport-steam": "1.0.18"
  },
  "devDependencies": {
    "@jest/globals": "30.0.0-beta.3",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/jest": "29.5.14",
    "@types/multer": "^1.4.13",
    "@types/passport-steam": "1.0.6",
    "@types/swagger-ui-dist": "3.30.5",
    "@types/typescript": "0.4.29",
    "jest": "29.7.0",
    "swagger-ui-dist": "5.24.1",
    "ts-jest": "29.3.4",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
