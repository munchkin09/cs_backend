FROM node:22-alpine AS builder
# Create app directory
WORKDIR /build

RUN echo "🚀 Starting build process..."
# Copy package files first for better Docker layer caching
COPY package*.json ./

# Install dependencies first (better caching)
RUN npm ci

# Copy only necessary source files (avoid problematic files)
COPY ./src/ ./src/
COPY ./static/ ./static/
COPY ./tsconfig.json ./

RUN set -e && \
    echo "🧑‍🚀 Starting build process..." && \
    npm run build && \
    echo "👨‍🚀 Build completed successfully"

# Stage 2: producción
FROM node:22-alpine AS production

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

RUN apk add --no-cache \
    ffmpeg \
    dumb-init \
    && rm -rf /var/cache/apk/*

# Definir argumentos de build
ARG LLM_API_KEY
ARG STEAM_API_KEY
ARG SESSION_SECRET
ARG STEAM_RETURN_URL
ARG DOMAIN
ARG MONGODB_URI

WORKDIR /app
COPY --from=builder /build/package*.json ./
COPY --from=builder /build/backend ./backend
COPY --from=builder /build/static ./static


# Install only production dependencies
RUN npm ci --include=dev --verbose && npm cache clean --force

# Change ownership to nodejs user
RUN chown -R nodejs:nodejs /app
USER nodejs



# Configurar las variables de entorno desde los argumentos de build
ENV LLM_API_KEY=${LLM_API_KEY}
ENV STEAM_API_KEY=${STEAM_API_KEY}
ENV SESSION_SECRET=${SESSION_SECRET}
ENV STEAM_RETURN_URL=${STEAM_RETURN_URL}
ENV DOMAIN=${DOMAIN}
ENV MONGODB_URI=${MONGODB_URI}
ENV NODE_ENV="development"

EXPOSE 3000

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

CMD ["node", "backend/src/index.js"]