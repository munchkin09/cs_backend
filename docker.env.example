# ===================================
# CS Backend Environment Variables
# ===================================

# Application
NODE_ENV=production
PORT=3000

# LLM Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here

# Database Configuration
MONGODB_URI=mongodb://admin:password@mongodb:27017
MONGODB_NAME=csainalyzer

# MongoDB Root Credentials (for Docker)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# Steam Authentication (if using)
STEAM_API_KEY=your_steam_api_key_here

# Optional: Azure Cosmos DB (if using instead of MongoDB)
# AZURE_COSMOS_CONNECTIONSTRING=your_cosmos_connection_string_here

# Security
SESSION_SECRET=your_session_secret_here

# FFmpeg Configuration (already included in Docker image)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Logging
LOG_LEVEL=info

# ===================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env to version control
# ===================================
